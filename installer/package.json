{
  "name": "yeorot-mcp-installer",
  "version": "0.1.0",
  "description": "yeorot MCP 설치 프로그램",
  "author": {
    "name": "xiilab",
    "email": "jip95@naver.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/waryongc/mcp.git"
  },
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "cloud.yeorot.mcp-installer",
    "productName": "yeorot MCP 설치",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "mcp/"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "waryongc",
      "repo": "mcp"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["universal"] }
      ],
      "category": "public.app-category.utilities"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Utility"
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
